---
import { Button } from "@/components/starwind/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="container mx-auto px-4 py-32 text-center">
    <p class="text-primary-accent text-sm font-semibold">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted-foreground mt-4">
      The page you're looking for doesn't exist or has moved.
    </p>
    <Button href="/" class="mt-8">
      Back to home
    </Button>
  </section>
</BaseLayout>
